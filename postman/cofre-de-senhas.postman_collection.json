{
  "info": {
    "name": "Cofre de Senhas API",
    "description": "Rotas da API do cofre de senhas. Rode as pastas em ordem (ou o Collection Runner): o login guarda o token e as criações guardam os IDs nas variáveis da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Gera um e-mail único por execução para o registro não dar 409",
          "if (!pm.collectionVariables.get('email')) {",
          "  pm.collectionVariables.set('email', 'maria' + Date.now() + '@email.com');",
          "}",
          "",
          "// Faz o papel do app autenticador: calcula o código TOTP atual a partir do segredo do 2FA",
          "const segredo = pm.collectionVariables.get('segredo2fa');",
          "if (segredo) {",
          "  const CryptoJS = require('crypto-js');",
          "  const alfabeto = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';",
          "  const bits = segredo.replace(/=+$/, '').split('').map((c) => alfabeto.indexOf(c).toString(2).padStart(5, '0')).join('');",
          "  const hex = bits.match(/.{8}/g).map((b) => parseInt(b, 2).toString(16).padStart(2, '0')).join('');",
          "  const contador = Math.floor(Date.now() / 1000 / 30).toString(16).padStart(16, '0');",
          "  const hmac = CryptoJS.HmacSHA1(CryptoJS.enc.Hex.parse(contador), CryptoJS.enc.Hex.parse(hex)).toString();",
          "  const offset = parseInt(hmac.slice(-1), 16);",
          "  const codigo = (parseInt(hmac.substr(offset * 2, 8), 16) & 0x7fffffff) % 1000000;",
          "  pm.collectionVariables.set('codigo2fa', String(codigo).padStart(6, '0'));",
          "}"
        ]
      }
    }
  ],
  "variable": [
